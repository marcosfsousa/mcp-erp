# The opt-in TLS profile, in one file and one flag:
#
#     docker compose --env-file tls.env up
#
# ADR-0005's option 6, taken as the non-default profile ADR-0011 named and
# ADR-0014 §*The wall came first, and one non-default profile takes it down*
# decided. `keycloak/README.md` §The opt-in TLS profile is the whole story,
# including the one step only a human can take.
#
# **`docker compose up` is untouched.** Every variable below has its
# plain-HTTP value as its default in `compose.yaml`, so the zero-setup run is
# the same run it was before this file existed — same ports, same issuer, no
# certificate, no trust step, every headless tier green.
#
# One flag rather than two, because `COMPOSE_PROFILES` is a setting Compose
# reads from the env file like any other. Neither `COMPOSE_FILE` nor a second
# `-f` is used: its separator is `:` on one platform and `;` on another, and a
# reader on the wrong one gets a missing-file error naming a path they never
# typed.

# Starts the certificate service, and only it. Every other service is outside
# every profile and starts either way.
COMPOSE_PROFILES=tls

# What every token says, what the resource server trusts, and what the browser
# types. The service name and the port do not move — they are what resolves
# identically inside the Compose network and on the host — so the scheme is the
# whole diff, and the scheme is the whole of what W3C Secure Contexts §3.1
# reads. `docs/organisation/seed.yaml` carries this string as `tls_issuer` and
# the principal directory holds the cast at it.
MCP_KEYCLOAK_ORIGIN=https://keycloak:8081

# The plain listener moves off the published port and stays inside the network,
# because the health probe speaks HTTP over one of bash's own file descriptors
# and the image carries nothing that speaks TLS. It is published nowhere, so
# what a caller outside the network can reach is TLS and nothing else.
MCP_KEYCLOAK_HTTP_PORT=8082

# The options that exist only under the profile, one file per service that reads
# them. They are files rather than variables because neither Quarkus nor OpenSSL
# treats an empty value as an absent one — each file says what it costs — and an
# `env_file` entry can be `required: false` where a `${VAR:-}` cannot.
#
# **Relative to the repository, not to this file**, because that is where
# Compose resolves an `env_file` path from. And `required: false` cuts both
# ways: it is what lets the default run read no file, and it is also why a typo
# in either path renders without a word — the stack comes up, and the resource
# server then refuses every token as `invalid_token` with the cause three
# services away. `tests/test_tls_profile.py` turns that into a red check
# instead: both paths must name a file that is here, and every absolute path
# inside those files must sit under the `/tls` mount `compose.yaml` declares.
MCP_TLS_KEYCLOAK_ENV=./keycloak/tls/keycloak.env
MCP_TLS_SERVER_ENV=./keycloak/tls/server.env
