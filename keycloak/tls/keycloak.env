# The Keycloak options that exist only under the TLS profile.
#
# They are here rather than in `compose.yaml`'s `environment:` block because
# Quarkus refuses an empty value outright — `Invalid empty value for option
# 'KC_HTTPS_KEY_STORE_FILE'`, measured on 26.7.1 — so the usual
# `${VAR:-}` interpolation cannot express "unset in the default configuration".
# An `env_file` can: `compose.yaml` names this path through a variable whose
# default points at nothing and marks the entry `required: false`, so the
# default run reads no file and Keycloak never sees these names.
#
# Everything that exists in *both* configurations stays interpolated in
# `compose.yaml`, because an `environment:` value wins over an `env_file` one and
# a setting split across the two would be decided by precedence rather than by
# whoever read it.

# The published port, and now the only one a caller outside the network can
# reach. `8081` rather than the conventional `8443` deliberately: the issuer's
# authority does not move, so the profile's entire diff is the scheme — which is
# the one thing W3C Secure Contexts §3.1 reads — and `docker compose up`
# publishes exactly the ports it publishes today.
KC_HTTPS_PORT=8081

# Minted by `generate.sh` into the directory `compose.yaml` mounts at `/tls`,
# on the reader's own machine. Nothing here is committed; the script says why.
KC_HTTPS_KEY_STORE_FILE=/tls/keycloak.p12

# On the same terms as the seed's password, and for a keystore that is
# regenerated from nothing whenever the reader deletes it.
KC_HTTPS_KEY_STORE_PASSWORD=not-a-secret-demo-password
