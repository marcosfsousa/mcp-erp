{
  "realm": "mcp-erp-neighbour",
  "displayName": "mcp-erp-neighbour",
  "enabled": true,

  "sslRequired": "none",
  "registrationAllowed": false,
  "rememberMe": false,
  "verifyEmail": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,

  "accessTokenLifespan": 300,
  "accessTokenLifespanForImplicitFlow": 300,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,

  "requiredActions": [
    {
      "alias": "VERIFY_PROFILE",
      "name": "Verify Profile",
      "providerId": "VERIFY_PROFILE",
      "enabled": false,
      "defaultAction": false,
      "priority": 90,
      "config": {}
    }
  ],

  "clientScopes": [
    {
      "name": "basic",
      "description": "The subject claim, asserted rather than read off the user, so a foreign token names a subject our directory holds. keycloak/README.md carries why.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "sub",
            "claim.value": "tomas-weber",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true",
            "access.tokenResponse.claim": "false"
          }
        }
      ]
    },
    {
      "name": "mcp-erp-audience",
      "description": "Our resource identifier, deliberately. A neighbour bound to its own audience would be refused by the audience comparison and foreign_issuer_token would prove nothing about iss.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "mcp-erp-resource",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "${MCP_RESOURCE_URL:http://localhost:8080/mcp}",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "erp.read",
      "description": "Read purchase requisitions in your cost centre",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Read purchase requisitions in your cost centre"
      },
      "protocolMappers": []
    },
    {
      "name": "erp.write",
      "description": "Raise requisitions and record invoices on your behalf",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Raise requisitions and record invoices on your behalf"
      },
      "protocolMappers": []
    },
    {
      "name": "erp.decide",
      "description": "Approve or reject purchase requisitions on your behalf",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Approve or reject purchase requisitions on your behalf"
      },
      "protocolMappers": []
    }
  ],

  "clients": [
    {
      "clientId": "mcp-neighbour",
      "name": "Neighbour client",
      "description": "token_passthrough and foreign_issuer_token. A real client of a real second issuer, so the token under test was minted rather than invented.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "consentRequired": true,
      "frontchannelLogout": false,
      "redirectUris": [
        "http://127.0.0.1:8085/callback",
        "http://localhost:8085/callback"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "defaultClientScopes": ["basic", "mcp-erp-audience"],
      "optionalClientScopes": ["erp.read", "erp.write", "erp.decide"]
    }
  ],

  "users": [
    {
      "username": "tomas.weber",
      "enabled": true,
      "realmRoles": [],
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "not-a-secret-demo-password",
          "temporary": false
        }
      ]
    }
  ]
}
